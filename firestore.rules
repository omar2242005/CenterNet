rules_version = '2';

// CenterNet — Firestore Rules (قسم الهوية والسنتر: users / centers / members / inviteCodes)
//
// المبادئ (من الملف الشامل، قسم 6):
//  - الافتراضي منع، وكل allow صريح.
//  - الصلاحيات من centers/{c}/members فقط. الـ Rules مبتقراش users.centerId ولا accountType أبدًا.
//  - مفيش delete على أي مسار هنا.
//
// افتراضات المسارات (لازم تتأكد منها):
//  - members تحت السنتر:  centers/{c}/members/{uid}
//  - students تحت السنتر: centers/{c}/students/{sid}   (بتتقرا بس للتحقق وقت إنشاء كود طالب/ولي أمر)
//  - inviteCodes على مستوى الجذر: inviteCodes/{code}   (والـ centerId جوه المستند)
//
// تعديل على الموديل: مستند العضو بيتزود فيه حقل inviteCode (اسم الكود المستخدم) عند قبول كود موظف.
// من غيره الـ Rules مش هتقدر تربط إنشاء العضوية بالكود في نفس الـ Batch.
//
// groups / sessions اتضافوا. الأقسام التانية (attendance / exams / scores) بتتضاف من C و D.
// لحد ما تتضاف، هي ممنوعة بالـ default deny اللي في آخر الملف.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // دوال مساعدة
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function centerPath(c) {
      return /databases/$(database)/documents/centers/$(c);
    }

    function memberPath(c, u) {
      return /databases/$(database)/documents/centers/$(c)/members/$(u);
    }

    function studentPath(c, s) {
      return /databases/$(database)/documents/centers/$(c)/students/$(s);
    }

  function groupPath(c, g) {
     return /databases/$(database)/documents/centers/$(c)/groups/$(g);
   }

    function counterPath(c) {
      return /databases/$(database)/documents/centers/$(c)/counters/students;
    }

    function codePath(id) {
      return /databases/$(database)/documents/inviteCodes/$(id);
    }

    function isActiveMember(c) {
      return signedIn()
        && exists(memberPath(c, request.auth.uid))
        && get(memberPath(c, request.auth.uid)).data.active == true;
    }

    function isAdmin(c) {
      return isActiveMember(c)
        && get(memberPath(c, request.auth.uid)).data.role == 'admin';
    }

    function memberRole(c) {
      return get(memberPath(c, request.auth.uid)).data.role;
    }

    // معلم أو مساعد نشط في السنتر.
    function isStaff(c) {
      return isActiveMember(c) && memberRole(c) in ['teacher', 'assistant'];
    }

  function sessionPath(c, s) {
      return /databases/$(database)/documents/centers/$(c)/sessions/$(s);
    }

    // معلم أو مساعد نشط، وهو من مجموعة الحصة دي.
    function isSessionStaff(c, sid) {
      return isStaff(c)
        && exists(sessionPath(c, sid))
        && exists(groupPath(c, get(sessionPath(c, sid)).data.groupId))
        && (get(groupPath(c, get(sessionPath(c, sid)).data.groupId)).data.teacherId == request.auth.uid
            || request.auth.uid in get(groupPath(c, get(sessionPath(c, sid)).data.groupId)).data.assistantIds);
    }
        function examPath(c, e) {
      return /databases/$(database)/documents/centers/$(c)/exams/$(e);
    }

    // معلم أو مساعد نشط في المجموعة دي.
    function isGroupStaff(c, gid) {
      return isStaff(c)
        && exists(groupPath(c, gid))
        && (get(groupPath(c, gid)).data.teacherId == request.auth.uid
            || request.auth.uid in get(groupPath(c, gid)).data.assistantIds);
    }

    // معلم المجموعة نفسه (مش المساعد).
    function isGroupTeacher(c, gid) {
      return isActiveMember(c)
        && memberRole(c) == 'teacher'
        && exists(groupPath(c, gid))
        && get(groupPath(c, gid)).data.teacherId == request.auth.uid;
    }

    // الأدمن أو معلم المجموعة: يدير الامتحانات والدرجات.
    function canManageGroupGrades(c, gid) {
      return isAdmin(c) || isGroupTeacher(c, gid);
    }

    
    // ------------------------------------------------------------------
    // التحقق من شكل المستندات
    // ------------------------------------------------------------------

    function validUser(d) {
      return d.keys().hasOnly(['name', 'email', 'phone', 'accountType', 'centerId',
                               'createdAt', 'createdBy', 'updatedAt'])
        && d.get('name', null) is string
        && d.get('accountType', null) is string;
    }

    function validCenter(d) {
      return d.keys().hasOnly(['name', 'year', 'createdBy', 'createdAt', 'lateAfterMinutes'])
        && d.get('name', null) is string
        && d.name.size() > 0 && d.name.size() <= 80
        && d.get('lateAfterMinutes', 15) is int
        && d.get('lateAfterMinutes', 15) >= 0
        && d.get('lateAfterMinutes', 15) <= 180;
    }

    function validMember(d) {
      return d.keys().hasOnly(['role', 'name', 'active', 'createdAt', 'createdBy', 'inviteCode'])
        && d.get('role', null) is string
        && d.get('name', null) is string
        && d.get('active', null) is bool;
    }

    // الطالب: الأدمن بس بيكتب. الرقم التسلسلي
    // لازم يساوي عدّاد السنتر، والعدّاد بيزيد 1 في نفس الـ Batch.
    function validStudent(d, c) {
      return d.keys().hasOnly(['centerId', 'studentNo', 'fullName', 'searchKey', 'phone',
                               'grade', 'groupIds', 'status', 'createdAt', 'createdBy'])
        && d.get('centerId', null) == c
        && d.get('studentNo', null) is int
        && d.get('fullName', null) is string
        && d.fullName.size() > 0 && d.fullName.size() <= 120
        && d.get('searchKey', null) is string
        && d.searchKey.size() > 0 && d.searchKey.size() <= 120
        && d.get('phone', null) is string && d.phone.size() <= 20
        && d.get('grade', null) is string && d.grade.size() <= 60
        && d.get('groupIds', null) is list
        && d.get('status', null) in ['active', 'archived'];
    }

    function validSlot(s) {
      return s is map
        && s.keys().hasOnly(['weekday', 'startMinutes', 'durationMinutes'])
        && s.get('weekday', null) is int
        && s.weekday >= 1 && s.weekday <= 7
        && s.get('startMinutes', null) is int
        && s.startMinutes >= 0 && s.startMinutes <= 1439
        && s.get('durationMinutes', null) is int
        && s.durationMinutes >= 1 && s.durationMinutes <= 480;
    }

    // [v6] فصل المعلم عن المساعد: العضو لازم يكون نشط وبالدور المطلوب بالظبط.
    // get واحدة بس (عضو مش موجود = خطأ تقييم = رفض) عشان نوفّر قراءات الـ Rules.
    function isActiveRole(c, u, role) {
      let m = get(memberPath(c, u)).data;
      return m.active == true && m.role == role;
    }

    // مساعد رقم i (لو موجود) لازم يكون مساعد نشط. مفيش loop في الـ Rules فبنكرر
    // لحد 6 (الحد الأقصى للمساعدين في المجموعة). حد الـ Rules 10 قراءات للكتابة
    // الواحدة: الأدمن 1 + المعلم 1 + المساعدين. جرّبنا على الـ Emulator: 7 بيعدّوا
    // و8 لأ، فاخترنا 6 وسيبنا هامش أمان.
    function assistantOk(d, c, i) {
      return d.assistantIds.size() <= i || isActiveRole(c, d.assistantIds[i], 'assistant');
    }

    // [v6] teacherId لازم معلم نشط، وكل assistantIds مساعدين نشطين.
    // المعلم والمساعد مينفعش يتبدلوا مكان بعض.
    function validStaffAssignment(d, c) {
      return d.get('teacherId', null) is string
        && d.get('assistantIds', null) is list && d.assistantIds.size() <= 6
        && isActiveRole(c, d.teacherId, 'teacher')
        && assistantOk(d, c, 0) && assistantOk(d, c, 1)
        && assistantOk(d, c, 2) && assistantOk(d, c, 3)
        && assistantOk(d, c, 4) && assistantOk(d, c, 5);
    }

    // Rules مش بتعمل loop، فبنتحقق من أول ميعاد بس. ده كفاية كحارس،
    // والـ model في Dart هو اللي بيتحقق من الباقي.
    function validGroup(d, c) {
      return d.keys().hasOnly(['centerId', 'name', 'subject', 'grade', 'teacherId',
                               'assistantIds', 'room', 'capacity', 'monthlyFee',
                               'slots', 'status', 'createdAt', 'createdBy'])
        && d.get('centerId', null) == c
        && d.get('name', null) is string
        && d.name.size() > 0 && d.name.size() <= 80
        && d.get('subject', null) is string && d.subject.size() <= 60
        && d.get('grade', null) is string && d.grade.size() <= 60
        && d.get('teacherId', null) is string
        && d.get('assistantIds', null) is list && d.assistantIds.size() <= 10
        && !(d.teacherId in d.assistantIds)
        && d.get('room', null) is string && d.room.size() <= 60
        && d.get('capacity', 1) is int && d.get('capacity', 1) >= 1
        && d.get('monthlyFee', null) is int && d.monthlyFee >= 0
        && d.get('slots', null) is list && d.slots.size() <= 14
        && (d.slots.size() == 0 || validSlot(d.slots[0]))
        && d.get('status', null) in ['active', 'archived'];
    }

    function validSession(d, c) {
      return d.keys().hasOnly(['centerId', 'groupId', 'startAt', 'endAt',
                               'status', 'createdAt', 'createdBy'])
        && d.get('centerId', null) == c
        && d.get('groupId', null) is string
        && exists(groupPath(c, d.groupId))
        && d.get('startAt', null) is timestamp
        && d.get('endAt', null) is timestamp
        && d.endAt > d.startAt
        && d.get('status', null) in ['scheduled', 'cancelled'];
    }

        // سجل الحضور: الـ id لازم = sessionId_studentId، وحقول الإلغاء بقيمها الابتدائية.
    function validAttendance(d, c, aid) {
      return d.keys().hasOnly(['centerId', 'sessionId', 'studentId', 'status', 'method',
                               'scannedAt', 'recordedBy', 'recordedAt',
                               'voided', 'voidedBy', 'voidReason', 'voidedAt'])
        && d.keys().hasAll(['centerId', 'sessionId', 'studentId', 'status', 'method',
                            'recordedBy', 'recordedAt',
                            'voided', 'voidedBy', 'voidReason', 'voidedAt'])
        && d.centerId == c
        && d.sessionId is string && d.sessionId.matches('[A-Za-z0-9_]+')
        && d.studentId is string && d.studentId.matches('[A-Za-z0-9]+')
        && aid == d.sessionId + '_' + d.studentId
        && d.status in ['present', 'late', 'excused']
        && d.method in ['qr', 'manual']
        && (d.method == 'qr'
              ? (d.get('scannedAt', null) is timestamp)
              : !d.keys().hasAny(['scannedAt']))
        && d.recordedBy == request.auth.uid
        && d.recordedAt == request.time
        && d.voided == false
        && d.voidedBy == null
        && d.voidReason == null
        && d.voidedAt == null;
    }
        function validExam(d, c) {
      return d.keys().hasOnly(['centerId', 'groupId', 'title', 'date', 'maxScore',
                               'published', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['centerId', 'groupId', 'title', 'date', 'maxScore',
                            'published', 'createdAt', 'createdBy'])
        && d.centerId == c
        && d.groupId is string
        && exists(groupPath(c, d.groupId))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.date is timestamp
        && d.maxScore is number && d.maxScore > 0
        && d.published == false
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    // قيم الدرجة: scored لازم score من 0 لحد max بخطوة 0.5، وغير كده score = null.
    function validScoreValues(d, maxScore) {
      return d.state in ['scored', 'absent', 'excused']
        && d.comment is string && d.comment.size() <= 300
        && (d.state == 'scored'
              ? (d.score is number
                 && d.score >= 0 && d.score <= maxScore
                 && math.floor(d.score * 2) == d.score * 2)
              : d.score == null);
    }

    // الدرجة: id = examId_studentId، والطالب في مجموعة الامتحان.
   function validScore(d, c, aid) {
      return d.keys().hasOnly(['centerId', 'examId', 'studentId', 'state', 'score',
                               'comment', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['centerId', 'examId', 'studentId', 'state', 'score',
                            'comment', 'createdAt', 'createdBy'])
        && d.centerId == c
        && d.examId is string && d.examId.matches('[A-Za-z0-9]+')
        && d.studentId is string && d.studentId.matches('[A-Za-z0-9]+')
        && aid == d.examId + '_' + d.studentId
        && exists(examPath(c, d.examId))
        && exists(studentPath(c, d.studentId))
        && get(examPath(c, d.examId)).data.groupId
             in get(studentPath(c, d.studentId)).data.groupIds
        && validScoreValues(d, get(examPath(c, d.examId)).data.maxScore)
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    // [P1] الدفعة: id = studentId_groupId_yyyyMM، والطالب والمجموعة موجودين.
    // الإنشاء دايمًا paid وبيانات إلغاء فاضية. المبلغ موجب، والشهر yyyyMM صالح.
    function validPayment(d, c, pid) {
      return d.keys().hasOnly(['centerId', 'studentId', 'groupId', 'month', 'amount',
                               'status', 'note', 'recordedBy', 'recordedAt',
                               'cancelledBy', 'cancelledAt', 'cancelReason'])
        && d.keys().hasAll(['centerId', 'studentId', 'groupId', 'month', 'amount',
                            'status', 'note', 'recordedBy', 'recordedAt',
                            'cancelledBy', 'cancelledAt', 'cancelReason'])
        && d.centerId == c
        && d.studentId is string && exists(studentPath(c, d.studentId))
        && d.groupId is string && exists(groupPath(c, d.groupId))
        && d.month is string && d.month.matches('^(19|20)[0-9]{2}(0[1-9]|1[0-2])$')
        && pid == d.studentId + '_' + d.groupId + '_' + d.month
        && d.amount is number && d.amount > 0
        && d.status == 'paid'
        && d.note is string && d.note.size() <= 300
        && d.recordedBy == request.auth.uid
        && d.recordedAt == request.time
        && d.cancelledBy == null && d.cancelledAt == null && d.cancelReason == null;
    }

    // [P1] إلغاء دفعة مدفوعة: status + بيانات الإلغاء بس، وسبب إلزامي.
    function validPaymentCancel(before, after) {
      return before.status == 'paid'
        && after.diff(before).affectedKeys()
             .hasOnly(['status', 'cancelledBy', 'cancelledAt', 'cancelReason'])
        && after.status == 'cancelled'
        && after.cancelledBy == request.auth.uid
        && after.cancelledAt == request.time
        && after.cancelReason is string
        && after.cancelReason.size() > 0 && after.cancelReason.size() <= 300;
    }

    // [P1] إعادة تسجيل دفعة ملغاة: ترجع paid بقيم جديدة وبيانات إلغاء فاضية.
    function validPaymentRerecord(before, after) {
      return before.status == 'cancelled'
        && after.diff(before).affectedKeys()
             .hasOnly(['status', 'amount', 'note', 'recordedBy', 'recordedAt',
                       'cancelledBy', 'cancelledAt', 'cancelReason'])
        && after.status == 'paid'
        && after.amount is number && after.amount > 0
        && after.note is string && after.note.size() <= 300
        && after.recordedBy == request.auth.uid
        && after.recordedAt == request.time
        && after.cancelledBy == null && after.cancelledAt == null
        && after.cancelReason == null;
    }

    function nextStudentNo(c) {
      return exists(counterPath(c)) ? get(counterPath(c)).data.next : 1;
    }

    // كود جديد: حد أقصى 7 أيام (+ يوم سماحية لفرق ساعة الجهاز).
    // كود الموظف دوره معلم أو مساعد فقط. مفيش كود بدور أدمن.
    function validNewCode(d) {
      return d.keys().hasOnly(['centerId', 'kind', 'role', 'name', 'studentId', 'relation',
                               'expiresAt', 'usedBy', 'createdAt', 'createdBy'])
        && d.get('centerId', null) is string
        && d.createdBy == request.auth.uid
        && d.get('usedBy', 'missing') == null
        && d.get('expiresAt', null) is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(8, 'd')
        && (
          (d.kind == 'staff'
            && d.get('role', '') in ['teacher', 'assistant']
            && d.get('name', null) is string)
          || (d.kind in ['student', 'guardian']
            && d.get('studentId', null) is string
            && exists(studentPath(d.centerId, d.studentId))
            && (d.kind == 'student' || d.get('relation', null) is string))
        );
    }

    // ------------------------------------------------------------------
    // الحالات الخاصة بإنشاء العضوية
    // ------------------------------------------------------------------

    // (أ) منشئ السنتر: عضو أدمن في سنتر جديد بيتكتب في نفس الـ Batch.
    //     لو السنتر موجود قبل كده، المسار ده مغلق (مينفعش حد يضيف نفسه أدمن).
    function bootstrapsCenter(c) {
      let d = request.resource.data;
      return d.role == 'admin'
        && d.active == true
        && !exists(centerPath(c))
        && existsAfter(centerPath(c))
        && getAfter(centerPath(c)).data.createdBy == request.auth.uid;
    }

    // (ب) قبول كود موظف: الكود صالح ولنفس السنتر وبنفس الدور، ومتعلّم مستخدم في نفس الـ Batch.
    function acceptsStaffInvite(c) {
      let d = request.resource.data;
      let id = d.get('inviteCode', '');
      return id is string && id.size() > 0
        && d.role in ['teacher', 'assistant']
        && d.active == true
        && exists(codePath(id))
        && get(codePath(id)).data.kind == 'staff'
        && get(codePath(id)).data.centerId == c
        && get(codePath(id)).data.role == d.role
        && get(codePath(id)).data.usedBy == null
        && get(codePath(id)).data.expiresAt > request.time
        && getAfter(codePath(id)).data.usedBy == request.auth.uid;
    }

    // استهلاك كود موظف (تعديل usedBy فقط) لازم يتزامن مع إنشاء العضوية المرتبطة بيه.
    // كود الطالب/ولي الأمر: consumesLinkCode (قسم Person 3 فوق).
    function consumesStaffCode(id) {
      let old = resource.data;
      let me = memberPath(old.centerId, request.auth.uid);
      return signedIn()
        && old.kind == 'staff'
        && old.usedBy == null
        && old.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(old).affectedKeys().hasOnly(['usedBy'])
        && !exists(me)
        && existsAfter(me)
        && getAfter(me).data.get('inviteCode', null) == id;
    }

    // الأدمن يقدر يلغي كود لسه ما اتستخدمش (بيخلي expiresAt = الآن).
    function revokesCode() {
      return isAdmin(resource.data.centerId)
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt <= request.time;
    }

    // ==================================================================
    // [Person 3] الطالب وولي الأمر: studentLinks + linkedUsers + guardianCounts
    //
    // * الطالب/ولي الأمر مش members. صلاحيتهم من centers/{c}/studentLinks/{uid_sid}.
    // * الربط بيتم بـ Batch واحد: استهلاك الكود (usedBy) + إنشاء الربط
    //   + زيادة العدّادات (FieldValue.increment) والـ Rules بتتحقق بـ getAfter.
    // * guardianCounts/{sid}.count = عدد أولياء الأمور النشطين (الحد الأقصى 4).
    // * linkedUsers/{uid}.count = عدد ربط المستخدم النشط. بيدّي قراءة المجموعات والحصص
    //   والامتحانات المنشورة بس (الـ Rules مش بتعرف الطالب من المستند، فبنعمّمها على السنتر).
    // * فك الربط: status فقط active -> unlinked، من صاحب الربط أو الأدمن، والعدّادات بتنقص.
    // * إعادة الربط بعد الفك: update من unlinked -> active بكود جديد (نفس شروط الإنشاء).
    // ==================================================================

    function linkPath(c, u, s) {
      return /databases/$(database)/documents/centers/$(c)/studentLinks/$(u + '_' + s);
    }

    function guardianCountPath(c, s) {
      return /databases/$(database)/documents/centers/$(c)/guardianCounts/$(s);
    }

    function linkedUserPath(c, u) {
      return /databases/$(database)/documents/centers/$(c)/linkedUsers/$(u);
    }

    // المستخدم الحالي مربوط (نشط) بالطالب ده.
    function hasLink(c, sid) {
      return signedIn()
        && exists(linkPath(c, request.auth.uid, sid))
        && get(linkPath(c, request.auth.uid, sid)).data.status == 'active';
    }

    // المستخدم الحالي عنده ربط نشط واحد على الأقل في السنتر.
    function isLinkedUser(c) {
      return signedIn()
        && exists(linkedUserPath(c, request.auth.uid))
        && get(linkedUserPath(c, request.auth.uid)).data.count > 0;
    }

    function countBefore(p) {
      return exists(p) ? get(p).data.count : 0;
    }

    function countAfter(p) {
      return existsAfter(p) ? getAfter(p).data.count : 0;
    }

    // الربط بيتفعّل في الـ Batch ده (مش موجود أو unlinked قبل، و active بعد).
    function linkActivating(c, u, s) {
      return existsAfter(linkPath(c, u, s))
        && getAfter(linkPath(c, u, s)).data.status == 'active'
        && (!exists(linkPath(c, u, s)) || get(linkPath(c, u, s)).data.status == 'unlinked');
    }

    // الربط بيتفك في الـ Batch ده (active قبل، و unlinked بعد).
    function linkDeactivating(c, u, s) {
      return exists(linkPath(c, u, s))
        && get(linkPath(c, u, s)).data.status == 'active'
        && existsAfter(linkPath(c, u, s))
        && getAfter(linkPath(c, u, s)).data.status == 'unlinked';
    }

    // الكود صالح للربط ده (بالحالة قبل الكتابة) ومتعلّم مستخدم بعدها.
    // d = بيانات الربط بعد الكتابة.
    function linkCodeOk(c, d) {
      let code = codePath(d.inviteCode);
      return exists(code)
        && get(code).data.kind == d.kind
        && get(code).data.centerId == c
        && get(code).data.studentId == d.studentId
        && get(code).data.usedBy == null
        && get(code).data.expiresAt > request.time
        && getAfter(code).data.usedBy == request.auth.uid
        && (d.kind == 'student' || d.relation == get(code).data.relation);
    }

    // العدّادات بتزيد بالظبط 1 (المستخدم + ولي الأمر للطالب، وماتعديش 4).
    function linkCountsBumped(c, d) {
      return countAfter(linkedUserPath(c, d.uid)) == countBefore(linkedUserPath(c, d.uid)) + 1
        && getAfter(linkedUserPath(c, d.uid)).data.sid == d.studentId
        && (d.kind == 'student'
            || (countAfter(guardianCountPath(c, d.studentId))
                  == countBefore(guardianCountPath(c, d.studentId)) + 1
                && countAfter(guardianCountPath(c, d.studentId)) <= 4));
    }

    // العدّادات بتنقص بالظبط 1 عند فك الربط. d = بيانات الربط قبل الفك.
    function linkCountsDropped(c, d) {
      return countAfter(linkedUserPath(c, d.uid)) == countBefore(linkedUserPath(c, d.uid)) - 1
        && (d.kind == 'student'
            || countAfter(guardianCountPath(c, d.studentId))
                 == countBefore(guardianCountPath(c, d.studentId)) - 1);
    }

    function validNewLink(d, c, lid) {
      return d.keys().hasOnly(['centerId', 'uid', 'studentId', 'kind', 'status', 'relation',
                               'inviteCode', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['centerId', 'uid', 'studentId', 'kind', 'status',
                            'inviteCode', 'createdAt', 'createdBy'])
        && d.centerId == c
        && d.uid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.studentId is string && d.studentId.matches('[A-Za-z0-9]+')
        && lid == d.uid + '_' + d.studentId
        && d.status == 'active'
        && d.createdAt == request.time
        && d.kind in ['student', 'guardian']
        && (d.kind == 'guardian'
              ? (d.get('relation', null) is string
                 && d.relation.size() > 0 && d.relation.size() <= 40)
              : !d.keys().hasAny(['relation']))
        && d.inviteCode is string && d.inviteCode.size() > 0
        && exists(studentPath(c, d.studentId))
        && linkCodeOk(c, d)
        && linkCountsBumped(c, d);
    }

    // إعادة الربط بعد الفك: نفس الشروط، والمسموح يتغيّر status و inviteCode و relation بس.
    function reactivatesLink(c) {
      let d = request.resource.data;
      return resource.data.status == 'unlinked'
        && resource.data.uid == request.auth.uid
        && d.status == 'active'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteCode', 'relation'])
        && d.inviteCode is string && d.inviteCode.size() > 0
        && (d.kind == 'guardian'
              ? (d.get('relation', null) is string
                 && d.relation.size() > 0 && d.relation.size() <= 40)
              : !d.keys().hasAny(['relation']))
        && linkCodeOk(c, d)
        && linkCountsBumped(c, d);
    }

    function unlinksLink(c) {
      return resource.data.status == 'active'
        && request.resource.data.status == 'unlinked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (resource.data.uid == request.auth.uid || isAdmin(c))
        && linkCountsDropped(c, resource.data);
    }

    // استهلاك كود طالب/ولي أمر (تعديل usedBy فقط) لازم يتزامن مع إنشاء/تفعيل الربط.
    function consumesLinkCode(id) {
      let old = resource.data;
      let s = old.get('studentId', null);
      return signedIn()
        && old.kind in ['student', 'guardian']
        && s is string
        && old.usedBy == null
        && old.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(old).affectedKeys().hasOnly(['usedBy'])
        && existsAfter(linkPath(old.centerId, request.auth.uid, s))
        && getAfter(linkPath(old.centerId, request.auth.uid, s)).data.inviteCode == id
        && getAfter(linkPath(old.centerId, request.auth.uid, s)).data.kind == old.kind
        && getAfter(linkPath(old.centerId, request.auth.uid, s)).data.status == 'active'
        && (!exists(linkPath(old.centerId, request.auth.uid, s))
            || get(linkPath(old.centerId, request.auth.uid, s)).data.status == 'unlinked');
    }

    // [v9] طلب ربط جديد: pending بس، من صاحب الحساب، بصلة قرابة لو ولي أمر.
    function validNewLinkRequest(d, c, rid) {
      return d.keys().hasOnly(['centerId', 'uid', 'name', 'studentNo', 'kind', 'relation',
                               'status', 'createdAt'])
        && d.keys().hasAll(['centerId', 'uid', 'name', 'studentNo', 'kind', 'status', 'createdAt'])
        && d.centerId == c
        && exists(centerPath(c))
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.studentNo is int && d.studentNo > 0
        && rid.matches(d.uid + '_[0-9]+')
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.kind in ['student', 'guardian']
        && (d.kind == 'guardian'
              ? (d.get('relation', null) is string
                 && d.relation.size() > 0 && d.relation.size() <= 40)
              : !d.keys().hasAny(['relation']));
    }

    // عدّاد ربط المستخدم: يزيد/ينقص 1، ومربوط بتغيّر حقيقي في الربط.
    function validLinkedUserWrite(c, u) {
      let d = request.resource.data;
      let before = resource == null ? 0 : resource.data.count;
      return signedIn()
        && d.keys().hasOnly(['count', 'sid'])
        && d.count is int && d.count >= 0 && d.count <= 100
        && d.sid is string && d.sid.matches('[A-Za-z0-9]+')
        && ((d.count == before + 1
             && request.auth.uid == u
             && linkActivating(c, u, d.sid))
            || (d.count == before - 1
                && (isAdmin(c)
                    || (request.auth.uid == u && linkDeactivating(c, u, d.sid)))));
    }

    // عدّاد أولياء أمور الطالب: يزيد 1 بربط ولي أمر جديد، وينقص 1 بفك ربط (ولي الأمر أو الأدمن).
    function validGuardianCountWrite(c, s) {
      let d = request.resource.data;
      let before = resource == null ? 0 : resource.data.count;
      return signedIn()
        && d.keys().hasOnly(['count'])
        && d.count is int && d.count >= 0 && d.count <= 4
        && ((d.count == before + 1
             && linkActivating(c, request.auth.uid, s)
             && getAfter(linkPath(c, request.auth.uid, s)).data.kind == 'guardian')
            || (d.count == before - 1
                && (isAdmin(c)
                    || (linkDeactivating(c, request.auth.uid, s)
                        && get(linkPath(c, request.auth.uid, s)).data.kind == 'guardian'))));
    }

    // ------------------------------------------------------------------
    // users/{uid}  — للتوجيه في الشاشات فقط، مفيش صلاحية بتيجي منه
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.createdBy == uid
        && request.resource.data.get('centerId', null) == null;

      allow update: if signedIn()
        && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;

      // حذف حسابي: صاحب الحساب بس (التطبيق بيمسح حساب Auth بعدها).
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // centers/{c}  و  centers/{c}/members/{uid}
    // ------------------------------------------------------------------
    match /centers/{c} {
      allow get: if isActiveMember(c);

      // الإنشاء ذري: السنتر + عضوية الأدمن في Batch واحد.
      allow create: if signedIn()
        && validCenter(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(memberPath(c, request.auth.uid))
        && getAfter(memberPath(c, request.auth.uid)).data.role == 'admin';

      allow update: if isAdmin(c)
        && validCenter(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'year', 'lateAfterMinutes']);

      allow delete: if false;

      match /members/{uid} {
        // العضو يقرا مستنده هو حتى لو اتعطّل (عشان التطبيق يعرف يوجّهه)، وباقي القائمة لأعضاء السنتر.
        allow get: if signedIn() && (request.auth.uid == uid || isActiveMember(c));
        allow list: if isActiveMember(c);

        allow create: if signedIn()
          && request.auth.uid == uid
          && validMember(request.resource.data)
          && request.resource.data.createdBy == uid
          && (bootstrapsCenter(c) || acceptsStaffInvite(c));

        // الأدمن بيغيّر اسم/تفعيل الموظفين (معلم/مساعد فقط). مفيش تعديل على
        // الأدمن نفسه، ومفيش تغيير دور.
        // [v6] الدور ثابت من وقت إنشاء الحساب: الأدمن يغيّر الاسم والتفعيل بس.
        allow update: if isAdmin(c)
          && resource.data.role in ['teacher', 'assistant']
          && request.resource.data.role == resource.data.role
          && request.resource.data.active is bool
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'active']);

        // العضو يمسح عضويته هو (حذف حسابي). الأدمن لأ: السنتر ملوش حذف
        // فهيفضل من غير أدمن.
        allow delete: if signedIn()
          && request.auth.uid == uid
          && resource.data.role in ['teacher', 'assistant'];
      }
    }

    // ------------------------------------------------------------------
    // centers/{c}/students/{sid}  و  centers/{c}/counters/students
    // الكتابة للأدمن فقط. القراءة للأدمن والمعلم/المساعد النشطين في السنتر.
    // TODO(C — خطوة 3.3): قراءة الطالب/ولي الأمر لسجله من studentLinks.
    //                      وتضييق قراءة المعلم/المساعد لطلاب مجموعاتهم فقط.
    // ------------------------------------------------------------------
    match /centers/{c}/students/{sid} {
      // [Person 3] الطالب/ولي الأمر يقرا الطالب المربوط بيه (get بس، مفيش list).
      allow get: if isAdmin(c) || isStaff(c) || hasLink(c, sid);
      allow list: if isAdmin(c) || isStaff(c);

      allow create: if isAdmin(c)
        && validStudent(request.resource.data, c)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.studentNo == nextStudentNo(c)
        && existsAfter(counterPath(c))
        && getAfter(counterPath(c)).data.next == request.resource.data.studentNo + 1;

      // تعديل البيانات والأرشفة. الرقم والسنتر والمنشئ ثابتين. مفيش حذف.
      allow update: if isAdmin(c)
        && validStudent(request.resource.data, c)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'searchKey', 'phone', 'grade', 'groupIds', 'status']);

      allow delete: if false;
    }

    match /centers/{c}/counters/students {
      allow get: if isAdmin(c);

      allow create: if isAdmin(c)
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 2;

      allow update: if isAdmin(c)
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // centers/{c}/groups/{gid}
    // الأدمن يكتب ويقرا. المعلم/المساعد يقرا المجموعات اللي هو فيها بس.
    // ------------------------------------------------------------------
    match /centers/{c}/groups/{gid} {
      // [Person 3] isLinkedUser: الطالب/ولي الأمر المربوط يقرا مجموعات السنتر (للجدول).
      allow get: if isAdmin(c)
        || (isStaff(c) && (resource.data.teacherId == request.auth.uid
                           || request.auth.uid in resource.data.assistantIds))
        || isLinkedUser(c);

      // list: أي موظف نشط يقرا قوائم مجموعات السنتر (الكتابة للأدمن بس).
      allow list: if isAdmin(c) || isStaff(c) || isLinkedUser(c);

      // [v8] المعلم النشط ينشئ مجموعة لنفسه بس (teacherId == uid). كل فحوصات
      // validGroup / validStaffAssignment (المساعدين نشطين وبدور مساعد) زي ما هي.
      // المساعد والمعلم المعطّل مرفوضين (isActiveRole). التعديل والحذف للأدمن بس.
      allow create: if (isAdmin(c)
            || (isActiveRole(c, request.auth.uid, 'teacher')
                && request.resource.data.get('teacherId', null) == request.auth.uid))
        && validGroup(request.resource.data, c)
        && validStaffAssignment(request.resource.data, c)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // [v6] لو التعيين (teacherId/assistantIds) اتغيّر لازم يعدي فحص الأدوار.
      // تعديلات تانية (أرشفة، اسم..) متتعطلش لو معلم قديم اتعطّل.
      allow update: if isAdmin(c)
        && validGroup(request.resource.data, c)
        && (!request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['teacherId', 'assistantIds'])
            || validStaffAssignment(request.resource.data, c))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'subject', 'grade', 'teacherId', 'assistantIds',
                       'room', 'capacity', 'monthlyFee', 'slots', 'status']);

      // الحذف النهائي للأدمن بس. الواجهة بتمنع حذف مجموعة ليها حصص أو طلاب
      // (الحصص والحضور نفسها مفيش حذف ليها، فهيبقوا يتامى).
      allow delete: if isAdmin(c);
    }

    // ------------------------------------------------------------------
    // centers/{c}/sessions/{sid}
    // الأدمن يكتب. المعلم/المساعد يقرا حصص مجموعاته.
    // الـ ID حتمي (gid_yyyyMMdd_HHmm بتوقيت القاهرة) والـ repository هو اللي بيضمنه،
    // لأن الـ Rules مش بتحسب التوقيت ده.
    // ------------------------------------------------------------------
    match /centers/{c}/sessions/{sid} {
      allow get: if isAdmin(c)
        || (isStaff(c)
            && exists(groupPath(c, resource.data.groupId))
            && (get(groupPath(c, resource.data.groupId)).data.teacherId == request.auth.uid
                || request.auth.uid in get(groupPath(c, resource.data.groupId)).data.assistantIds))
        // [Person 3] الطالب/ولي الأمر المربوط يقرا حصص السنتر (للجدول).
        || isLinkedUser(c);

      // list: أي موظف نشط يقرا قوائم حصص السنتر (الكتابة للأدمن بس).
      allow list: if isAdmin(c) || isStaff(c) || isLinkedUser(c);

      allow create: if isAdmin(c)
        && validSession(request.resource.data, c)
        && request.resource.data.status == 'scheduled'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // الإلغاء: حقل status بس، ومن scheduled لـ cancelled.
      allow update: if isAdmin(c)
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // المسح النهائي: الأدمن وللحصة الملغاة بس. الحصة المجدولة مبتتمسحش أبدًا
      // (بتتلغي الأول). فحص "عليها حضور؟" في الـ repository لأن الـ Rules
      // مبتقدرش تعمل query.
      allow delete: if isAdmin(c) && resource.data.status == 'cancelled';
    }

        // ------------------------------------------------------------------
    // centers/{c}/attendance/{aid}   (aid = sessionId_studentId)
    // الكتابة والقراءة: الأدمن، أو معلم/مساعد مجموعة الحصة.
    // مفيش delete: الإلغاء = update لحقول الإلغاء بس مع سبب.
    // TODO(C): قراءة الطالب/ولي الأمر لحضوره من studentLinks.
    // ------------------------------------------------------------------
    match /centers/{c}/attendance/{aid} {
      // [Person 3] الطالب/ولي الأمر يقرا حضور الطالب المربوط بيه بس.
      allow get: if isAdmin(c) || isSessionStaff(c, resource.data.sessionId)
        || hasLink(c, resource.data.studentId);

      // list: أي موظف نشط يقرا قوائم حضور السنتر (الكتابة للأدمن بس)،
      // والطالب/ولي الأمر المربوط يقرا حضور الطالب المربوط بيه بس
      // (استعلامه لازم يكون مقيّد بـ studentId).
      allow list: if isAdmin(c) || isStaff(c) || hasLink(c, resource.data.studentId);

      allow create: if validAttendance(request.resource.data, c, aid)
        && (isAdmin(c) || isSessionStaff(c, request.resource.data.sessionId))
        && exists(sessionPath(c, request.resource.data.sessionId))
        && exists(studentPath(c, request.resource.data.studentId));

      allow update: if (isAdmin(c) || isSessionStaff(c, resource.data.sessionId))
        && resource.data.voided == false
        && request.resource.data.voided == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['voided', 'voidedBy', 'voidReason', 'voidedAt'])
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() >= 1
        && request.resource.data.voidReason.size() <= 300
        && request.resource.data.voidedAt == request.time;

      allow delete: if false;
    }
        // ------------------------------------------------------------------
    // centers/{c}/exams/{eid}
    // الأدمن أو معلم المجموعة ينشئ وينشر. المعلم/المساعد بتوع المجموعة يقروا.
    // النشر = تعديل حقل published بس. مفيش delete.
    // TODO(C): قراءة الطالب/ولي الأمر للامتحانات المنشورة بس من studentLinks.
    // ------------------------------------------------------------------
    match /centers/{c}/exams/{eid} {
      // [Person 3] الطالب/ولي الأمر المربوط يقرا الامتحانات المنشورة بس.
      allow get, list: if isAdmin(c) || isGroupStaff(c, resource.data.groupId)
        || (resource.data.published == true && isLinkedUser(c));

      allow create: if validExam(request.resource.data, c)
        && canManageGroupGrades(c, request.resource.data.groupId);

      allow update: if canManageGroupGrades(c, resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published'])
        && request.resource.data.published is bool;

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // centers/{c}/scores/{aid}   (aid = examId_studentId)
    // الأدمن أو معلم المجموعة يكتب. المعلم/المساعد بتوع المجموعة يقروا.
    // التعديل: state/score/comment بس. مفيش delete.
    // TODO(C): قراءة الطالب/ولي الأمر لدرجاته المنشورة بس.
    // ------------------------------------------------------------------
    match /centers/{c}/scores/{aid} {
      // [Person 3] الطالب/ولي الأمر يقرا درجات الطالب المربوط بيه في الامتحانات المنشورة بس.
      // [v7] get على مستند مش موجود: resource بيبقى null و resource.data بيرمي خطأ = رفض،
      // وده كان بيكسر أول رصد للمعلم (الـ transaction بتعمل get قبل الـ create).
      // لو المستند مش موجود بنطلّع الامتحان من الـ id (examId_studentId) ونسمح للأدمن
      // أو معلم/مساعد مجموعة الامتحان بس. مفيش قراءة لطالب/ولي أمر على مستند مش موجود.
      allow get: if resource == null
        ? (isAdmin(c)
            || (aid.matches('[A-Za-z0-9]+_[A-Za-z0-9]+')
                && exists(examPath(c, aid.split('_')[0]))
                && isGroupStaff(c, get(examPath(c, aid.split('_')[0])).data.groupId)))
        : (isAdmin(c)
            || (exists(examPath(c, resource.data.examId))
                && isGroupStaff(c, get(examPath(c, resource.data.examId)).data.groupId))
            || (hasLink(c, resource.data.studentId)
                && exists(examPath(c, resource.data.examId))
                && get(examPath(c, resource.data.examId)).data.published == true));

      allow list: if isAdmin(c)
        || (exists(examPath(c, resource.data.examId))
            && isGroupStaff(c, get(examPath(c, resource.data.examId)).data.groupId))
        || (hasLink(c, resource.data.studentId)
            && exists(examPath(c, resource.data.examId))
            && get(examPath(c, resource.data.examId)).data.published == true);

      allow create: if validScore(request.resource.data, c, aid)
        && canManageGroupGrades(c, get(examPath(c, request.resource.data.examId)).data.groupId);

      allow update: if exists(examPath(c, resource.data.examId))
        && canManageGroupGrades(c, get(examPath(c, resource.data.examId)).data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state', 'score', 'comment'])
        && validScoreValues(request.resource.data,
                            get(examPath(c, resource.data.examId)).data.maxScore);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // [P1] centers/{c}/payments/{pid}   (pid = studentId_groupId_yyyyMM)
    // تسجيل دفع نقدي يدوي: الأدمن بس يكتب. المساعد يقرا (علامة الدفع في
    // المسح). الإلغاء منطقي بسبب، وإعادة التسجيل بعد الإلغاء = تحديث. مفيش delete.
    // TODO(P1): ولي الأمر يقرا دفعات ابنه لما شاشاته تتبني.
    // ------------------------------------------------------------------
    match /centers/{c}/payments/{pid} {
      allow get, list: if isAdmin(c)
        || (isActiveMember(c) && memberRole(c) == 'assistant');

      allow create: if isAdmin(c) && validPayment(request.resource.data, c, pid);

      allow update: if isAdmin(c)
        && (validPaymentCancel(resource.data, request.resource.data)
            || validPaymentRerecord(resource.data, request.resource.data));

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // [Person 3] centers/{c}/studentLinks/{lid}  (lid = uid_studentId)
    // القراءة: صاحب الربط أو الأدمن. الكتابة: ربط بكود / فك ربط / إعادة ربط. مفيش delete.
    // ------------------------------------------------------------------
    match /centers/{c}/studentLinks/{lid} {
      // get بيتحقق من الـ id (مش من resource) عشان قراءة ربط مش موجود تفشل بشكل سليم.
      allow get: if signedIn()
        && (lid.matches(request.auth.uid + '_[A-Za-z0-9]+') || isAdmin(c));
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin(c));

      allow create: if validNewLink(request.resource.data, c, lid);

      allow update: if unlinksLink(c) || reactivatesLink(c);

      allow delete: if false;
    }

    // [v9] طلبات الربط: الطالب/ولي الأمر يبعت طلب للأدمن، والأدمن يوافق فيكتب كود ربط
    // في الطلب (status = approved + code) والطالب يكمّل الربط بالكود ده بالطريقة العادية.
    // id الطلب = uid_studentNo. صاحب الطلب يقراه ويمسحه، والأدمن يقرا ويرد (approved/rejected).
    match /centers/{c}/linkRequests/{rid} {
      allow get: if signedIn()
        && (rid.matches(request.auth.uid + '_[0-9]+') || isAdmin(c));
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin(c));

      allow create: if validNewLinkRequest(request.resource.data, c, rid);

      allow update: if isAdmin(c)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'code'])
        && (request.resource.data.status == 'rejected'
            || (request.resource.data.get('code', null) is string
                && request.resource.data.code.size() > 0));

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // [Person 3] عدّاد أولياء الأمور النشطين للطالب (حد أقصى 4). بيتكتب مع الربط/الفك بس.
    match /centers/{c}/guardianCounts/{sid} {
      allow get: if isAdmin(c);
      allow create, update: if validGuardianCountWrite(c, sid);
      allow delete: if false;
    }

    // [Person 3] عدّاد ربط المستخدم النشط (بيدّي قراءة الجدول والامتحانات المنشورة).
    match /centers/{c}/linkedUsers/{u} {
      allow get: if signedIn() && request.auth.uid == u;
      allow create, update: if validLinkedUserWrite(c, u);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // inviteCodes/{code}  — get فقط، مفيش list
    // ------------------------------------------------------------------
    match /inviteCodes/{code} {
      allow get: if signedIn();

      allow create: if signedIn()
        && validNewCode(request.resource.data)
        && isAdmin(request.resource.data.centerId);

      allow update: if consumesStaffCode(code) || consumesLinkCode(code) || revokesCode();

      allow delete: if false;
    }

    // أي مسار تاني ممنوع لحد ما حد يكتب له قسم صريح.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
